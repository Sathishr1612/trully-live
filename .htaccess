RewriteEngine On
RewriteRule ^tulyy-the-jawai-leopard-kingdom(\.html)?$ /trulyy-the-jawai-leopard-kingdom [R=301,L,NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]
RewriteCond %{THE_REQUEST} ^GET\s([^.]+)\.html\sHTTP [NC]
RewriteRule ^([^.]+)\.html$ /$1 [NC,L,R=301]